---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PlaceSection from '../components/PlaceSection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Journeys from '../components/Journeys.astro';
import Footer from '../components/Footer.astro';

const places = (await getCollection('places')).sort((a, b) => a.data.order - b.data.order);

// Each place's marker points to the next place; the last one leads into "How a walk works".
const nextFor = (i: number) => {
	const next = places[i + 1];
	return next ? { label: `${next.data.name} next`, href: `#${next.id}` } : { label: 'How a walk works', href: '#how' };
};
---

<Base>
	<Nav firstPlaceId={places[0].id} />
	<main id="top">
		<h1 class="visually-hidden">Kine Tours. Small, slow walks through the parts of Ethiopia the tour buses skip.</h1>
		{
			places.map((place, i) => (
				<PlaceSection place={place} index={i + 1} total={places.length} next={nextFor(i)} />
			))
		}
		<HowItWorks />
		<Journeys />
	</main>
	<Footer places={places} />
</Base>

<script>
	import '../scripts/motion';
</script>
