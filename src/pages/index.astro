---
// Temporary setup check — replaced by the real landing page in the next step.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const places = (await getCollection('places')).sort((a, b) => a.data.order - b.data.order);
const journeys = await getCollection('journeys');
---

<Base>
	<main class="check">
		<p class="label">Setup check · {places.length} places · {journeys.length} journeys</p>
		<h1>Kine Tours</h1>
		<ul>
			{
				places.map((place) => (
					<li style={`--ink: var(--color-ink-${place.data.ink})`}>
						<Image src={place.data.image} alt={place.data.imageAlt} width={480} />
						<p class="label">{place.data.coordinates}</p>
						<h2>{place.data.title}</h2>
						<p class="kicker">{place.data.kicker}</p>
					</li>
				))
			}
		</ul>
	</main>
</Base>

<style>
	.check {
		max-width: var(--container-page);
		margin-inline: auto;
		padding: var(--spacing-24) var(--spacing-16);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-10);
	}
	h1 {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: var(--text-display);
		line-height: var(--leading-display);
		letter-spacing: var(--tracking-display);
	}
	ul {
		list-style: none;
		padding: 0;
		display: flex;
		gap: var(--spacing-6);
	}
	li {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		color: var(--ink);
	}
	li img {
		width: 100%;
		height: 200px;
		object-fit: cover;
		object-position: center 80%;
	}
	h2 {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: var(--text-headline);
		line-height: var(--leading-headline);
		letter-spacing: var(--tracking-headline);
	}
	.kicker {
		font-family: var(--font-display);
		font-style: italic;
		font-size: var(--text-lead);
	}
</style>
